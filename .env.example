# Demo mode serves data from /data/demo and simulates orders in the browser.
NEXT_PUBLIC_USE_DEMO_API=true
# EXAMPLE address only – replace with the backend developer's real API URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Absolute site origin for canonical URLs, sitemap, robots and JSON-LD (no trailing slash).
# Optional: falls back to Vercel's production domain, then https://new-restaurant-kappa.vercel.app
NEXT_PUBLIC_SITE_URL=https://new-restaurant-kappa.vercel.app
